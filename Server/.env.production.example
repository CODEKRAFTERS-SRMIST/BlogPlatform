# NEVER commit .env.production to git
# Copy to .env.production and fill in real values

NODE_ENV=production
PORT=3001

# PostgreSQL (must match docker-compose.prod.yml POSTGRES_* vars)
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=
USE_COOKIES=true

# Seed — super admin created on first deploy
ADMIN_EMAIL=president@yourcollege.edu
ADMIN_PASSWORD=ChangeThisNow@2026!
ADMIN_NAME=Club President

# App
FRONTEND_URL=https://yourdomain.com

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_DISABLE=true

# Logging
LOG_LEVEL=warn
