# Copy to .env and fill in. Values marked (required) must be set for the
# server to start doing anything useful.

# --- Database (required) ---------------------------------------------------
# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (required) -------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ----------------------------------------------------------------
# The Next proxy in client/next.config.ts defaults to port 5000, so keep these
# in step if you change one.
PORT=5000
NODE_ENV=development

# --- Frontend ---------------------------------------------------------------
# Used for CORS and for the links in outgoing email.
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Cookies ----------------------------------------------------------------
# USE_COOKIES (required). The browser holds its session in an httpOnly cookie
# and never sends an Authorization header, so with this unset or 'false' you
# can log in successfully and then be treated as a stranger on every page
# after it. The server refuses to start without it rather than let that
# happen quietly.
USE_COOKIES=true
#
# Set COOKIE_SECURE=true when serving over HTTPS (production does this
# automatically via NODE_ENV). Use 'none' for SameSite only if the API and the
# frontend sit on different sites.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Image storage: Cloudflare R2 -------------------------------------------
# All five are needed for uploads to reach R2. With any of them missing the
# server falls back to writing into Server/uploads and serving /uploads, which
# is fine for local development but is refused when NODE_ENV=production.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the bucket, no trailing slash.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Email (SMTP) -----------------------------------------------------------
# EMAIL_PASS must be a Gmail App Password (16 chars), not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# --- Optional ---------------------------------------------------------------
ADMIN_EMAIL=
